<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RoslynTools>$(MSBuildToolsPath)/DotnetTools/dotnet-format</RoslynTools>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="$(RoslynTools)/*.dll" />
    <Reference Include="$(RoslynTools)/BuildHost-netcore/Microsoft.Build.Locator.dll" />
    <None Include="$(RoslynTools)/BuildHost-netcore/**/*" CopyToOutputDirectory="PreserveNewest" Link="BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
