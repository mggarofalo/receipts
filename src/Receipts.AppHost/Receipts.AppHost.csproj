<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>b5ec2e0d-4615-427e-9fdc-7c109cb3902a</UserSecretsId>
    <!--
      ASPIRE010 (new in 13.6) flags that the SDK defaults AspireUseCliBundle to
      false. This AppHost runs on the DCP and dashboard from its NuGet packages,
      as it did before 13.6, so the warning carries no action for us.
    -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Presentation\API\API.csproj" />
    <ProjectReference Include="..\Tools\DbMigrator\DbMigrator.csproj" />
    <ProjectReference Include="..\Tools\DbSeeder\DbSeeder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
  </ItemGroup>

</Project>
