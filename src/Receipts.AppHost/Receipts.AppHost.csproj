<Project Sdk="Aspire.AppHost.Sdk/13.1.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>b5ec2e0d-4615-427e-9fdc-7c109cb3902a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Presentation\API\API.csproj" />
    <ProjectReference Include="..\Tools\DbMigrator\DbMigrator.csproj" />
    <ProjectReference Include="..\Tools\DbSeeder\DbSeeder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.1.3" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.1.3" />
    <!--
      Pinned for security: GHSA-hv8m-jj95-wg3x, patched in 2.5.301 (RECEIPTS-828).
      MessagePack arrives transitively through Aspire.Hosting. This project pins
      versions inline rather than opting into central package management, so the
      CentralPackageTransitivePinningEnabled pin in Directory.Packages.props does
      not reach it and a direct reference is needed. Drop this once Aspire ships
      a patched MessagePack of its own.
    -->
    <PackageReference Include="MessagePack" Version="2.5.301" />
  </ItemGroup>

</Project>
