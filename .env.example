# Docker Compose production environment variables
# Copy to .env and fill in values before running docker compose up

# --- Docker Image ---
# Pin an exact release. Tags have no leading v (0.18.1, not v0.18.1).
IMAGE_TAG=latest

# --- Telemetry (optional, see docs/observability.md) ---
# Referenced from docker-compose.yml as
#   - OTEL_EXPORTER_OTLP_HEADERS=${OTEL_EXPORTER_OTLP_HEADERS}
# so the credential stays out of the compose file.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <token>

# --- Sentry ---
# Server-side (API): passed as env var at runtime
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# Client-side (React): passed as Docker build args via CI
# SENTRY_AUTH_TOKEN=sntrys_...  (for source map uploads in CI)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=receipts-frontend
